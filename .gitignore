# ── SECRETS — jangan pernah commit ──
.env
.env.*
# Templates only. `!.env.example` alone was not enough once the second chain arrived: `.env.*`
# above swallows .env.arc.example too, so the file both READMEs and the ROADMAP tell the operator
# to `cp` would never have been committed — and nobody notices a file that was never added.
# The pattern is negated by SHAPE (*.example), so the next chain's template is covered already.
!.env.example
!.env.*.example
*.pem
*.key
*.keystore
keypair*
secrets*.json
# GMGN keypair / config, OpenRouter key, wallet private key semuanya di luar repo (.env / ~/.config)

# deps & build
node_modules/
dist/

# runtime state (PnL history + posisi live — back up sendiri, jangan commit)
data/
positions.json
lp-ledger.json
watch-history.json
v4-positions.json
autolp-state.json
*.lock

# logs
*.log
bot.log

# installed agent skills (GMGN CLI skills — buat pakai interaktif, bukan bagian bot)
.agents/
skills-lock.json

# Claude Code local (skills, settings)
.claude/
