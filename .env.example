# ═══════════════════════════════════════════════════════════════════
#  Robinhood LP Bot v2 — .env
#
#  1. Rename this file to .env (remove ".example")
#  2. Fill in the values below
#  3. Never share, commit, or screenshot this file. The private key controls funds.
# ═══════════════════════════════════════════════════════════════════

# ── 1) Main RPC — mint, close, and position reads ─────────────────
#  Create an app at https://alchemy.com → choose the "Robinhood" chain.
#  Copy the HTTPS URL here.
RH_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Optional read fallback. Keep the public endpoint here even when RH_RPC_URL is Alchemy/private.
RH_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# ── 2) EVM wallet private key (0x… 64 hex) ─────────────────────────
#  Use a new burner wallet, not your primary wallet.
#  Fund it with ETH on Robinhood Chain for LP capital and gas.
#  Generate one quickly: node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
RH_WALLET_KEY=0xYOUR_WALLET_PRIVATE_KEY

# ── 3) Telegram bot token ──────────────────────────────────────────
#  Message @BotFather → /newbot → copy the token here.
RH_TG_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# ── 4) OWNER chat ID — SECURITY GATE. REQUIRED. ───────────────────
#  Only this chat can command the bot (mint/close/sell). Without it,
#  anyone who finds the bot could control the wallet.
#  The bot refuses to start if this is empty.
#  Get the ID by messaging @userinfobot in Telegram.
RH_TG_CHAT=

# ── 5) Dedicated volume-scan RPC (optional, recommended) ─────────
#  Create a SECOND Alchemy app with a separate key.
#  The scanner polls every 2 minutes; separating it protects the main
#  RPC quota while transactions are being submitted.
#  Leave empty to reuse the main RPC.
RH_WATCH_RPC_URL=

# ── 6) Sequencer feed monitor (optional) ──────────────────────────
#  Enables real-time new-token and out-of-range detection from the feed.
#  Enable with Telegram: /feed on (or feed.enabled in config).
#
#  RH_FEED_IP: required if your network hijacks the feed domain DNS.
#  Leave empty on a US VPS.
RH_FEED_IP=
#  Optional feed URL override:
# RH_FEED_URL=wss://feed.mainnet.chain.robinhood.com/feed

# ── 7) Fast-submit to the sequencer (optional) ────────────────────
#  Broadcast transactions directly to the sequencer, bypassing the Alchemy relay.
#  Reads still use Alchemy; only eth_sendRawTransaction is redirected.
#  Most useful on a US VPS. Enable by setting this to 1.
RH_FAST_SUBMIT=
#  Optional sequencer URL/IP override. Pin the IP if your local DNS is hijacked.
# RH_SEQUENCER_URL=https://sequencer.mainnet.chain.robinhood.com/
# RH_SEQUENCER_IP=3.136.74.196

# ── 8) LLM radar (OpenRouter) — optional ──────────────────────────
#  Scores and confirms token candidates with an LLM.
#  Create a key at https://openrouter.ai/keys. Enable with: /set radar 1
RH_OPENROUTER_KEY=
#  Model (free default). Other options include: anthropic/claude-3.5-haiku, x-ai/grok-2
# RH_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional spacing between LLM requests; protects free models from burst throttling.
# RH_LLM_MIN_GAP_MS=2000

# ── 9) KyberSwap aggregator — optional ────────────────────────────
#  If empty, the bot uses a direct v3 swap when available. USDG pairs
#  require the aggregator. The router must be Kyber's official Robinhood
#  Chain address; never guess or reuse an address from another chain.
KYBERSWAP_AGGREGATOR_API_BASE_URL=https://aggregator-api.kyberswap.com
KYBERSWAP_CHAIN=robinhood
KYBERSWAP_ROUTER_ADDRESS=0x6131B5fae19EA4f9D964eAc0408E4408b66337b5

# ── 10) GMGN enrichment — optional ─────────────────────────────────
#  Enrich candidates with GMGN data (smart money, holders, security) via gmgn-cli.
#  Set it up on the machine running the bot (the key binds to a local keypair):
#    npm install -g gmgn-cli
#    gmgn-cli config              # generate a keypair and display a URL
#    # open the URL, create an API key for the displayed public key, then:
#    gmgn-cli config --apply <API_KEY>
#  The bot calls gmgn-cli automatically; no environment variable is needed here.

# ── 11) Blockscout / briefing / card — optional ───────────────────
#  A Blockscout API key only increases the rate limit.
RH_BLOCKSCOUT_KEY=
#  Daily briefing: defaults to RH_OPENROUTER_* with a separate model.
# RH_BRIEF_URL=https://openrouter.ai/api/v1/chat/completions
# RH_BRIEF_KEY=
# RH_BRIEF_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
#  Profit-card branding:
# RH_CARD_BRAND=0xRapzz
# RH_CARD_TAG=LP · ONCHAIN WATCH
# RH_CARD_BG=/absolute/path/to/card-bg.jpg

# ── 12) Runtime tuning — optional; normally leave empty ───────────
# RH_RPC_TIMEOUT_MS=20000
# RH_RPC_STALL_MS=1500
# RH_PUBLIC_RPC_STALL_MS=2500
# RH_TX_WAIT_MS=75000
# RH_POLL_MS=350
# RH_FVLOW_WINDOW_MS=900000
# RH_NUDGE_MS=30000

# ── 13) Logging — optional ─────────────────────────────────────────
#  LOG_LEVEL: debug | info | warn | error   (default info)
#  LOG_FILE : log file path (default: stdout only)
# LOG_LEVEL=info
# LOG_FILE=bot.log
